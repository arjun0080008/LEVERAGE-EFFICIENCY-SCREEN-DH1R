# Required in production (Vercel injects it automatically when you attach a Blob store to the project)
BLOB_READ_WRITE_TOKEN=

# Required: Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on cron invocations.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Required. Daily bars come from Polygon.io grouped-daily aggregates (free "Basic" plan is enough).
POLYGON_API_KEY=

# Optional tuning (defaults shown)
# MIN_DOLLAR_VOLUME_USD=1000000
# MIN_BARS=260
# INDUSTRY_MIN_N=8
# TIME_BUDGET_MS=45000
# MAX_HOPS=400
# BACKFILL_DAYS=740

# Local development only: store bars/snapshots on disk under ./.data instead of Vercel Blob
# STORE=fs
